<Window x:Class="QuestCast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quest Cast" Height="700" Width="1020" MinHeight="600" MinWidth="920"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                <TextBlock Text="Quest Cast" Style="{StaticResource H1}" />
                <TextBlock x:Name="TxtSub" Style="{StaticResource Small}" Text="каст шлема через Wi-Fi ADB" />
            </StackPanel>
            <Border x:Name="MicChip" Style="{StaticResource Chip}" Margin="0,0,10,0"
                    Background="#3A1418" BorderBrush="#7A2A32" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="МИКРОФОН" Style="{StaticResource Small}" />
                    <TextBlock x:Name="TxtMic" Text="OFF" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Bad}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Chip}" Margin="0,0,10,0" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="КАСТ" Style="{StaticResource Small}" />
                    <TextBlock x:Name="TxtCast" Text="—" FontSize="17" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Chip}" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="ШЛЕМ" Style="{StaticResource Small}" />
                    <TextBlock x:Name="TxtDevice" Text="—" FontSize="17" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- controls -->
        <Border Grid.Row="1" Style="{StaticResource Chip}" Padding="16">
            <StackPanel>
                <TextBlock Text="ГЛАЗ" Style="{StaticResource Small}" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <RadioButton x:Name="RbLeft" Content="Левый" GroupName="eye" IsChecked="True" Click="Eye_Click" Margin="0,0,20,0" />
                    <RadioButton x:Name="RbRight" Content="Правый" GroupName="eye" Click="Eye_Click" Margin="0,0,20,0" />
                    <RadioButton x:Name="RbBoth" Content="Оба" GroupName="eye" Click="Eye_Click" />
                </StackPanel>

                <!-- a WrapPanel inside a StackPanel never wraps: it measures with an
                     infinite width, so buttons ran off the right edge. Fixed grid here. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" x:Name="BtnStart" Content="СТАРТ" Style="{StaticResource Primary}" Height="42" Margin="0,0,8,8" Click="Start_Click" />
                    <Button Grid.Row="0" Grid.Column="1" x:Name="BtnStop" Content="СТОП" Height="42" Margin="0,0,8,8" Click="Stop_Click" />
                    <Button Grid.Row="0" Grid.Column="2" x:Name="BtnRestart" Content="ПЕРЕЗАПУСК" Height="42" Margin="0,0,8,8" Click="Restart_Click" />
                    <Button Grid.Row="0" Grid.Column="3" x:Name="BtnMic" Content="МИКРОФОН ВКЛ" Height="42" Margin="0,0,0,8" Click="Mic_Click" />

                    <Button Grid.Row="1" Grid.Column="0" x:Name="BtnLens" Content="ЛИНЗА ВКЛ" Height="42" Margin="0,0,8,8" Click="Lens_Click" />
                    <Button Grid.Row="1" Grid.Column="1" x:Name="BtnCalib" Content="КАЛИБРОВКА" Height="42" Margin="0,0,8,8" Click="Calib_Click" />
                    <Button Grid.Row="1" Grid.Column="2" x:Name="BtnFirewall" Content="ОТКРЫТЬ ПОРТ" Height="42" Margin="0,0,8,8" Click="Firewall_Click" ToolTip="Разрешить входящие подключения на порт управления (нужны права администратора)" />
                    <Button Grid.Row="1" Grid.Column="3" x:Name="BtnAuto" Content="АВТО-ГОРИЗОНТ" Height="42" Margin="0,0,0,8" Click="Auto_Click" ToolTip="Держать горизонт по гироскопу шлема: клиент присылает крен по сети" />

                    <Button Grid.Row="2" Grid.Column="0" x:Name="BtnSign" Content="ЗНАК КРЕНА: ОБЫЧНЫЙ" Height="38" Margin="0,0,8,8" Click="Sign_Click" ToolTip="Если горизонт уезжает не в ту сторону - переверните знак крена" />
                    <Button Grid.Row="2" Grid.Column="1" x:Name="BtnGuide" Content="ЛИНИЯ" Height="38" Margin="0,0,8,8" Click="Guide_Click" ToolTip="Показать контрольную линию на стриме: эталон рисует клиент в шлеме" />
                    <Button Grid.Row="2" Grid.Column="2" x:Name="BtnMinus" Content="- 0.5°" Height="38" Margin="0,0,8,8" Click="Minus_Click" ToolTip="Повернуть картинку на полградуса для юстировки по линиям" />
                    <Button Grid.Row="2" Grid.Column="3" x:Name="BtnPlus" Content="+ 0.5°" Height="38" Margin="0,0,0,8" Click="Plus_Click" ToolTip="Повернуть картинку на полградуса для юстировки по линиям" />

                    <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="BtnGainDown" Content="ГЕЙН -" Height="38" Margin="0,0,8,0" Click="GainDown_Click" ToolTip="Сколько градусов картинки даёт градус крена: уменьшить, если горизонт уезжает слабее головы" />
                    <Button Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" x:Name="BtnGainUp" Content="ГЕЙН +" Height="38" Margin="0,0,0,0" Click="GainUp_Click" ToolTip="Увеличить передачу: если при наклоне головы горизонт отстаёт" />
                </Grid>

                <TextBlock x:Name="TxtBusy" Style="{StaticResource Small}" Margin="0,6,0,0" Text="" />
            </StackPanel>
        </Border>

        <!-- LAN -->
        <Border Grid.Row="2" Style="{StaticResource Chip}" Padding="16" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="СЕТЬ / ANDROID-КЛИЕНТ" Style="{StaticResource Small}" />
                    <TextBlock x:Name="TxtLan" Text="—" FontSize="14" Margin="0,4,0,0" />
                    <TextBlock x:Name="TxtPort" Style="{StaticResource Small}" Text="" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="ТОКЕН" Style="{StaticResource Small}" HorizontalAlignment="Right" />
                        <TextBlock x:Name="TxtToken" Text="—" FontSize="20" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Content="КОПИРОВАТЬ" Width="120" Height="36" Click="Copy_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- log -->
        <Border Grid.Row="3" Style="{StaticResource Chip}" Padding="10" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ЖУРНАЛ" Style="{StaticResource Small}" Margin="4,2,0,6" />
                <TextBox x:Name="TxtLog" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="11"
                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="4" x:Name="TxtFoot" Style="{StaticResource Small}" Margin="2,10,0,0" Text="" />
    </Grid>
</Window>

